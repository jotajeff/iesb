<IfModule mod_rewrite.c>
    RewriteEngine On

    # Permite acesso direto ao endpoint físico do webhook Asaas
    RewriteRule ^asaas-webhook\.php$ - [L]

    # Mantém arquivos e diretórios reais (assets, uploads etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todas as outras rotas vão para o front controller
    RewriteRule ^ index.php [L,QSA]
</IfModule>
